FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Optional: custom city hall / LGU name for display header
QUEUE_ORG_NAME=LGU Queuing System

# Ticket printing uses the browser print dialog / configured browser behavior.

# SMS notification (Semaphore — https://semaphore.co)
# When a ticket is among the next N in line, sends an SMS to the customer.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE
NEAR_NOTIFY_THRESHOLD=3

# Read-aloud clip generation — BUILD MACHINE ONLY, never deployed to a kiosk.
# `node scripts/generate-voice-clips.mjs` renders the kiosk's announcements to
# MP3 under public/audio/. Those files ship inside the installer, so the kiosk
# speaks with no internet and no API key on the device.
#
# The DEFAULT provider needs none of the keys below — leave them blank unless
# you want neural voices. See public/audio/README.md.
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
